void setupDAC_DMA() {
  PMC->PMC_PCER1 |= PMC_PCER1_PID38;

  DACC->DACC_MR =
      DACC_MR_TRGEN_DIS |
      DACC_MR_USER_SEL_CHANNEL1 |
      DACC_MR_WORD_HALF |
      DACC_MR_REFRESH(1) |
      DACC_MR_STARTUP_8;

  DACC->DACC_CHER = DACC_CHER_CH1;

  // DMA DAC
  DACC->DACC_TPR = (uint32_t)buffer;
  DACC->DACC_TCR = BUF_SIZE;
  DACC->DACC_TNPR = (uint32_t)buffer;
  DACC->DACC_TNCR = BUF_SIZE;

  DACC->DACC_PTCR = DACC_PTCR_TXTEN; // Active DMA TX
}

void DACC_Handler() {
  DACC->DACC_ISR;  // effacer le register d’état
}

