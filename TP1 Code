#define PinTimer 2
#define RC 328 //Todo: Définir la valeur trouver pour le registre de comparaison
#define BUF_SIZE 128
uint16_t buffer[BUF_SIZE];

void setupTimer(){
  /*Todo:
    Partie 1:
    1 - Activer le périphérique Timer
    2 - Configurer le registre TC_CMR
    3 - Valeur du registre de comparaison
    4 - Activation de l'interruption par RC Compare
    5 - Activation de l'interruption dans le NVIC de la Due
  */
  // 1 - Activer le périphérique Timer
  PMC->PMC_PCER0 |= (1 << ID_TC0);

  // 2 - Configurer le registre TC_CMR
  TC0->TC_CHANNEL[0].TC_CMR =
      TC_CMR_TCCLKS_TIMER_CLOCK3 |  // MCK / 32
      TC_CMR_WAVE |                 // Mode onde
      TC_CMR_WAVSEL_UP_RC;           // Reset compteur sur RC

  // 3 - Valeur du registre de comparaison RC
  // 84 MHz / 128 = 656250 Hz
  // 656250 / 1000 = 656 → 1 ms
  TC0->TC_CHANNEL[0].TC_RC = RC;

  // 4 - Activation de l'interruption RC Compare
  TC0->TC_CHANNEL[0].TC_IER = TC_IER_CPCS;
  TC0->TC_CHANNEL[0].TC_IDR = ~TC_IER_CPCS;

  // 5 - Activation NVIC
  NVIC_EnableIRQ(TC0_IRQn);

  // Démarrage du Timer
  TC0->TC_CHANNEL[0].TC_CCR =
      TC_CCR_CLKEN | TC_CCR_SWTRG;
}

void TC0_Handler(){
  /*Todo:
    Partie 1:
    1 - Lire et effacer le drapeau d'interruption
    2 - Changer l'état du pin timer pour analyser la fréquence du timer sur oscilloscope

    Partie 2:
    1 - Lancer manuellement la conversion de l'ADC
  */
  // 1 - Lire et effacer le drapeau d'interruption
  TC0->TC_CHANNEL[0].TC_SR;

  // 2 - Changer l'état du pin timer
  digitalWrite(PinTimer, !digitalRead(PinTimer));

  // Partie 2:
  // 1 - Lancer manuellement la conversion ADC
  ADC->ADC_CR = ADC_CR_START;
}

