void setupADC_DMA() {
  PMC->PMC_PCER1 |= PMC_PCER1_PID37;

  ADC->ADC_MR =
      ADC_MR_TRGEN_DIS |
      ADC_MR_LOWRES_BITS_12 |
      ADC_MR_PRESCAL(3) |
      ADC_MR_STARTUP_SUT64 |
      ADC_MR_SETTLING_AST3 |
      ADC_MR_TRACKTIM(15);

  ADC->ADC_CHER = ADC_CHER_CH7;

  // DMA ADC
  ADC->ADC_RPR = (uint32_t)buffer;
  ADC->ADC_RCR = BUF_SIZE;
  ADC->ADC_RNPR = (uint32_t)buffer;
  ADC->ADC_RNCR = BUF_SIZE;

  ADC->ADC_PTCR = ADC_PTCR_RXTEN; // Active DMA RX
}

