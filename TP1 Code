void loop() {
  //Partie 2:
  if(ADC->ADC_ISR & ADC_ISR_EOC7){ // Fin de conversion canal ADC7
    //Todo: 
    //Partie 2:
    // 1 - Afficher des valeurs de l'ADC sur le moniteur série
    uint16_t val = ADC->ADC_CDR[7];

    static uint16_t decim = 0;
    if (++decim >= 1000) {   // 16 Hz seulement
      Serial.println(val);
      decim = 0;
    }
  

    // 2 - Sortie sur le DAC des valeurs de l'ADC
    DACC->DACC_CDR = DACC_CDR_DATA(val);
    while (!(DACC->DACC_ISR & DACC_ISR_TXRDY));
  }
}
