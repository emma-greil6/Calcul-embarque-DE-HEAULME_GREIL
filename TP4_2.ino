#define ELU

// Architecture du réseau : 100 entrées, 4 neurones, 3 neurones, 1 sortie
const unsigned int layers[] = {100, 4, 3, 1};
float *output;

void setup() {
  Serial.begin(115200);

  NeuralNetwork NN(layers, NumberOf(layers));

  unsigned long startTime = millis();

  // Entraînement
  do {
    for (unsigned int j = 0; j < NumberOf(inputs); j++) {
      NN.FeedForward(inputs[j]);
      NN.BackProp(expectedOutput[j]);
    }
    // MSE seule sur la ligne = tracé par le Serial Plotter
    Serial.println(NN.MeanSqrdError, 6);

  } while (NN.getMeanSqrdError(NumberOf(inputs)) > 0.001);

  unsigned long trainTime = millis() - startTime;

  Serial.print("Temps d'entrainement : ");
  Serial.print(trainTime);
  Serial.println(" ms");

  // Prédictions sur testData
  Serial.println("--- Predictions sur testData ---");
  for (unsigned int i = 0; i < NumberOf(testData); i++) {
    output = NN.FeedForward(testData[i]);
    Serial.print("testData[");
    Serial.print(i);
    Serial.print("] => ");
    Serial.print(output[0], 4);
    if (output[0] >= 0.5) {
      Serial.println("  → Forme 1 (croix)");
    } else {
      Serial.println("  → Forme 0 (cercle)");
    }
  }

  NN.print();
}

